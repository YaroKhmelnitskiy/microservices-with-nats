{
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node10",
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "strictNullChecks": true,
    "incremental": false,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "./",
    "paths": {
      "@auth": [
        "libs/auth/src"
      ],
      "@auth/*": [
        "libs/auth/src/*"
      ],
      "@pino-shared": [
        "libs/pino/src"
      ],
      "@pino-shared/*": [
        "libs/pino/src/*"
      ],
      "@shared": [
        "libs/shared/src"
      ],
      "@shared/*": [
        "libs/shared/src/*"
      ],
      "@utils": [
        "libs/utils/src"
      ],
      "@utils/*": [
        "libs/utils/src/*"
      ]
    }
  }
}